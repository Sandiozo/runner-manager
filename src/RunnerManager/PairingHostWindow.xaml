<Window x:Class="RunnerManager.PairingHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a PC" Icon="assets/RunnerManager.ico" Width="500" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource Bg1Brush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="OptionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="OptionText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="28,26,28,24">
            <!-- Waiting -->
            <StackPanel x:Name="WaitingPanel">
                <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SelectedBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE8AF;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <TextBlock Text="Waiting for a PC to join…" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" Margin="0,12,0,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,14,0,0" LineHeight="20">
                    <Run Text="On the other PC, open Runner Manager and click"/>
                    <Run Text="Connect another PC" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><Run Text=" in the sidebar, then Join an existing fleet. It finds"/>
                    <Run x:Name="ThisPcRun" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <Run Text="automatically if both PCs are on the same network."/>
                </TextBlock>
                <TextBlock x:Name="AddressText" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="ExpiryText" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="CopyNoteText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"
                           Text="The fleet code is copied. A PC that gets this code joins the fleet with full access. To manage a PC one way, let it join through this window instead. Keep the fleet code private, like a password."/>
                <!-- A PC that has its code and asks its user whether the codes match. -->
                <TextBlock x:Name="ConfirmingText" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20" Visibility="Collapsed"/>
                <TextBlock x:Name="JoinedText" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="JoinedNoteText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                           Text="A PC that joined appears in the sidebar within a few seconds. Add more PCs, or click Done."/>
                <TextBlock x:Name="NotAddedText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Request -->
            <StackPanel x:Name="RequestPanel" Visibility="Collapsed">
                <TextBlock x:Name="RequestTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <!-- Shown when the name or the machine ID of the PC that asks belongs to a PC known here, or when it cannot be added. -->
                <Border x:Name="SameNamePanel" Background="{DynamicResource BadgeWarnBgBrush}" BorderBrush="{DynamicResource BadgeWarnBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,4" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,9,0"/>
                        <TextBlock x:Name="SameNameText" FontSize="12" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <TextBlock Text="Check that the other PC shows the same 6-digit code:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                <Border Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                    <TextBlock x:Name="CodeText" FontSize="36" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                               HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="What can it do?" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <RadioButton x:Name="FullAccessOption" Style="{StaticResource OptionCard}" GroupName="Access" Checked="AccessOption_Checked"
                             AutomationProperties.Name="Join the fleet">
                    <StackPanel>
                        <TextBlock Text="Join the fleet" Style="{StaticResource OptionTitle}"/>
                        <TextBlock Text="It gets the fleet code. It can view and control every PC in the fleet, and they can control it." Style="{StaticResource OptionText}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ManagedAccessOption" Style="{StaticResource OptionCard}" GroupName="Access" Checked="AccessOption_Checked"
                             AutomationProperties.Name="Manage it one way">
                    <StackPanel>
                        <TextBlock Text="Manage it one way" Style="{StaticResource OptionTitle}"/>
                        <TextBlock Style="{StaticResource OptionText}"
                                   Text="It gets an access code of its own, not the fleet code. The fleet's PCs and AI assistants can view and control it, but it cannot see or control them. For a PC that belongs to someone else."/>
                    </StackPanel>
                </RadioButton>
                <TextBlock x:Name="ManagedUnavailableText" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"
                           Text="To manage it one way, update Runner Manager on it to 2.8 or later first."/>
                <!-- Says that an option must be chosen while Allow is turned off. -->
                <TextBlock x:Name="AllowNoteText" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="First choose what it can do. Allow only if the codes match."/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel>
                <Button x:Name="CopyCodeButton" Content="Copy fleet code instead" Style="{StaticResource GhostButton}" Click="CopyCode_Click"
                        ToolTip="For a PC that cannot find this one. Paste the fleet code on that PC under “Other ways to join”. That PC joins the fleet with full access."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DenyButton" Content="Deny" Style="{StaticResource GhostButton}" Click="Deny_Click" MinWidth="88" Visibility="Collapsed"/>
                    <Button x:Name="AllowButton" Content="Allow" Style="{StaticResource PrimaryButton}" Click="Allow_Click" Margin="8,0,0,0" MinWidth="110" Visibility="Collapsed"/>
                    <Button x:Name="CloseButton" Content="Done" Margin="8,0,0,0" MinWidth="96" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
