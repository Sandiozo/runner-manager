<Window x:Class="RunnerManager.MoveRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RunnerManager"
        Title="Move runner" Icon="assets/RunnerManager.ico" Width="500" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg1Brush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="28,24,28,22">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,18"/>

            <TextBlock Text="Move to" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
            <Border Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                <ListBox x:Name="TargetList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         MaxHeight="220" SelectionChanged="TargetList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MachineInfo}">
                            <DockPanel>
                                <TextBlock Text="{Binding MachineGlyph}" Style="{StaticResource Icon}" Margin="0,0,12,0" Foreground="{DynamicResource TextMutedBrush}"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MachineName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="  this PC" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" VerticalAlignment="Bottom" Visibility="{Binding ThisPcVisibility}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RunnerSummary}" Style="{StaticResource Caption}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <CheckBox x:Name="DeleteOldToggle" Style="{StaticResource ToggleSwitch}" IsChecked="True" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="DeleteOldText"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="When off, the old folder is kept without its registration, so its files can still be copied."/>
                </StackPanel>
            </CheckBox>

            <Border Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,16,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" LineHeight="18"
                           Text="1. The runner stops on its current PC.&#x0a;2. The target PC downloads the latest runner and registers it with the same name and labels. This replaces the old registration.&#x0a;3. The Windows service on the old PC is removed, and its files if selected above.&#x0a;If step 2 fails, the runner starts again on its current PC."/>
            </Border>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="88"/>
                <Button x:Name="MoveButton" Content="Move runner" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Move_Click" Margin="8,0,0,0" MinWidth="120" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
