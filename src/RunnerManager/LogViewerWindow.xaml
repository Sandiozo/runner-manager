<Window x:Class="RunnerManager.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log" Icon="assets/RunnerManager.ico" Width="980" Height="640" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg0Brush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="20,14,14,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Width="220" Margin="0,0,8,0">
                    <TextBox x:Name="FilterBox" Tag="Filter lines" Padding="30,6,10,6" TextChanged="FilterBox_TextChanged"/>
                    <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Left" Margin="11,0,0,0"
                               Foreground="{DynamicResource TextFaintBrush}" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Click="Refresh_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Click="Copy_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Save as…" Click="Save_Click"/>
                <Button x:Name="FolderButton" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open log folder" Click="Folder_Click" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>
        <ProgressBar x:Name="Progress" Grid.Row="1" Style="{StaticResource ThinProgress}" IsIndeterminate="True"/>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="14,0,14,14" CornerRadius="8">
            <Grid>
                <TextBox x:Name="LogText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="10,8" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <StackPanel x:Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="StateGlyph" Text="&#xE895;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Caption}" FontSize="13" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
