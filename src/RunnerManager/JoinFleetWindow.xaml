<Window x:Class="RunnerManager.JoinFleetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up a fleet" Icon="assets/RunnerManager.ico" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg1Brush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SubtleFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="28,24,28,24">
            <TextBlock x:Name="HeadingText" Text="Set up a fleet" FontSize="20" FontWeight="SemiBold"/>

            <!-- Step 1: choose -->
            <StackPanel x:Name="ChoicePanel" Margin="0,16,0,0">
                <Button Style="{StaticResource ChoiceCard}" Click="ChooseJoin_Click" AutomationProperties.Name="Join an existing fleet">
                    <DockPanel>
                        <TextBlock Text="&#xE8AF;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Join an existing fleet" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Another PC is already in a fleet. You confirm a 6-digit code on both PCs."/>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource ChoiceCard}" Click="ChooseNew_Click" Margin="0,10,0,0" AutomationProperties.Name="Start a new fleet">
                    <DockPanel>
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,16,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Start a new fleet" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="This is the first PC. To add other PCs later, click “Add a PC” in the sidebar."/>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </StackPanel>

            <!-- Step 2: find a PC -->
            <StackPanel x:Name="FindPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" LineHeight="20">
                    <Run Text="On a PC that is already in the fleet, click"/>
                    <Run Text="Add a PC" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><Run Text=". That PC then appears below. Click it to join."/>
                </TextBlock>
                <Border Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="4" Margin="0,14,0,0" MinHeight="64">
                    <Grid>
                        <ItemsControl x:Name="HostList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="12,9"
                                            Tag="{Binding}" Click="Host_Click" AutomationProperties.Name="{Binding Name, StringFormat='Join {0}'}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="Join" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" Margin="0,0,12,0" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="SearchingPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Searching for PCs…" Foreground="{DynamicResource TextFaintBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Shown when the search has found nothing for a while. -->
                <StackPanel x:Name="NothingFoundPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="No PC found yet. Check these points:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="•  “Add a PC” is open on the other PC."/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="•  Both PCs are on the same network."/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="•  No firewall or VPN blocks the search."/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Or enter the address of the other PC under “Other ways to join”."/>
                </StackPanel>

                <Button x:Name="OtherWaysButton" Content="Other ways to join ▾" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Margin="-8,10,0,0" Click="OtherWays_Click"/>
                <StackPanel x:Name="OtherWaysPanel" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock Text="Address of the other PC (for Tailscale or another network)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddressBox" Tag="For example, desktop-pc or 100.101.102.103" AutomationProperties.Name="Address of the other PC"
                                     KeyDown="AddressBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Connect" Margin="8,0,0,0" Click="ConnectAddress_Click"/>
                        </Grid>
                        <TextBlock Text="Or enter the fleet code" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CodeBox" Tag="rwk_…" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Fleet code"
                                     KeyDown="CodeBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Join" Margin="8,0,0,0" Click="PasteCode_Click"/>
                        </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Step 3: confirm the number -->
            <StackPanel x:Name="ConfirmPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                <Border Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                    <TextBlock x:Name="CodeText" Text="··· ···" FontSize="36" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center"/>
                </Border>
                <ProgressBar x:Name="JoinProgress" Style="{StaticResource ThinProgress}" IsIndeterminate="True" Margin="0,14,0,0"/>
                <TextBlock x:Name="WaitText" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <!-- Shown once the other PC has allowed: what to do when the codes differ. -->
                <TextBlock x:Name="MismatchText" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="20" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Style="{StaticResource GhostButton}" Click="Back_Click" MinWidth="80" Visibility="Collapsed"/>
                <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="88" Margin="8,0,0,0"/>
                <!-- Not the default button, and never focused by code: a stray Enter must not accept a code. -->
                <Button x:Name="ConfirmButton" Content="The codes match" Style="{StaticResource PrimaryButton}" Click="CodesMatch_Click"
                        MinWidth="130" Margin="8,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
