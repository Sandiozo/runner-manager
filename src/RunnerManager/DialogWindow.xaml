<Window x:Class="RunnerManager.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runner Manager" Icon="assets/RunnerManager.ico" MinWidth="460" MaxWidth="760" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg1Brush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- Looks like a TextBlock, but the text can be selected and copied (error output from config.cmd or gh). -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- A Decorator rather than a ScrollViewer, so the mouse wheel scrolls the dialog. -->
                    <ControlTemplate TargetType="TextBox">
                        <Decorator x:Name="PART_ContentHost"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- A long message scrolls; the buttons stay on screen. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="24,22,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" Margin="0,0,14,0">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="16"/>
                </Border>
                <!-- A long text wraps at the width of a plain dialog instead of widening it. A wide row of buttons widens the
                     dialog, and then the text gets that width too (DialogWindow.FitTextToButtons). -->
                <StackPanel x:Name="TextPanel" Grid.Column="1" MaxWidth="350" HorizontalAlignment="Left">
                    <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBox x:Name="MessageText" Style="{StaticResource SelectableText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                             TextBlock.LineHeight="19" Margin="-2,8,-2,0"/>
                    <Border x:Name="DetailBox" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBox x:Name="DetailText" Style="{StaticResource SelectableText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="1" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
