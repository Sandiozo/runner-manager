<Window x:Class="RunnerManager.EditRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit runner" Icon="assets/RunnerManager.ico" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg1Brush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Edit runner" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,20"/>

            <TextBlock Text="Runner name" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="RunnerNameBox"/>

            <TextBlock Text="Custom labels" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,6"/>
            <TextBox x:Name="LabelsBox" Tag="Comma-separated"/>
            <TextBlock x:Name="LabelsHint" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>

            <Border Background="{DynamicResource BadgeWarnBgBrush}" BorderBrush="{DynamicResource BadgeWarnBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,18,0,0">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,9,0"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="Saving removes the runner registration and registers it again on its PC. The runner cannot pick up jobs for a few seconds."/>
                </DockPanel>
            </Border>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Click="Cancel_Click" MinWidth="88"/>
                <Button Content="Save changes" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" Margin="8,0,0,0" MinWidth="120"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
