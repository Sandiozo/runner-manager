<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used for the notification-area (tray) icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\RunnerManager.ico</ApplicationIcon>
    <AssemblyName>RunnerManager</AssemblyName>
    <RootNamespace>RunnerManager</RootNamespace>
    <!-- Release builds override this from the git tag (see .github/workflows/release.yml). -->
    <Version>2.2.3</Version>
    <Product>Runner Manager</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="RunnerManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\RunnerManager.ico" />
    <Resource Include="assets\RunnerManager.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>
</Project>
