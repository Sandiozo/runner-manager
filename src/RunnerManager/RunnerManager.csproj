<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used for the notification-area (tray) icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Per-monitor DPI awareness is set in app.manifest, because WPF starts the app; the WinForms analyzer's
         alternative (Application.SetHighDpiMode) only applies to WinForms apps. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>assets\RunnerManager.ico</ApplicationIcon>
    <AssemblyName>RunnerManager</AssemblyName>
    <RootNamespace>RunnerManager</RootNamespace>
    <!-- Release builds override this from the git tag (see .github/workflows/release.yml). -->
    <Version>2.10.0</Version>
    <Product>Runner Manager</Product>
    <!-- Shown in the exe's Properties → Details. An exe without a publisher or description looks more like malware to
         antivirus scanners. AssemblyTitle is the file description that Task Manager and Defender show. -->
    <AssemblyTitle>Runner Manager</AssemblyTitle>
    <Description>Manages GitHub Actions self-hosted runners on your Windows PCs</Description>
    <Company>Sandiozo</Company>
    <Authors>Sandiozo</Authors>
    <Copyright>Copyright © 2026 Sandiozo</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Runner Manager runs with administrator rights. Any program of the user can set DOTNET_STARTUP_HOOKS for the user,
         so the runtime must not load the assemblies it names. Debug builds keep them for Hot Reload. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The published exe looks for .NET only where it is installed for the whole PC (the registered and the default
         location), never in DOTNET_ROOT, which any program of the user can set. Publish only; a self-contained exe
         carries its own runtime and ignores it. -->
    <AppHostDotNetSearch>Global</AppHostDotNetSearch>
  </PropertyGroup>

  <!-- The start helper, RunnerManagerLauncher.exe (src\RunnerManagerLauncher): a small native program that starts
       RunnerManager.exe with a clean environment. It is built with the Visual C++ tools before the app and embedded in it,
       so a release stays one exe; the installed app writes it beside itself (see Launcher.cs). Without the tools the build
       goes on without it, and the app then registers its tasks at the exe as before. A release passes
       -p:RequireLauncher=true, so it cannot be built without it. LauncherExe may be set to another file (the tests do). -->
  <PropertyGroup>
    <LauncherFolder>$(MSBuildThisFileDirectory)..\RunnerManagerLauncher\</LauncherFolder>
    <LauncherExe Condition="'$(LauncherExe)' == ''">$(LauncherFolder)bin\RunnerManagerLauncher.exe</LauncherExe>
  </PropertyGroup>

  <Target Name="BuildLauncher" BeforeTargets="BeforeBuild" Condition="'$(SkipLauncherBuild)' != 'true'">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(LauncherFolder)build.ps1&quot; -IfToolsPresent" />
  </Target>

  <Target Name="CheckLauncher">
    <Error Condition="'$(RequireLauncher)' == 'true' and !Exists('$(LauncherExe)')"
           Text="RequireLauncher is set, but the start helper $(LauncherExe) is missing. Build it first with src\RunnerManagerLauncher\build.ps1 (it needs the Visual C++ x64 build tools); a release must not be built without it." />
  </Target>

  <!-- In a target, not as a static item: the file may only exist once BuildLauncher has run. -->
  <Target Name="EmbedLauncher" BeforeTargets="BeforeBuild" DependsOnTargets="BuildLauncher;CheckLauncher">
    <ItemGroup Condition="Exists('$(LauncherExe)')">
      <EmbeddedResource Include="$(LauncherExe)" LogicalName="RunnerManagerLauncher.exe" />
    </ItemGroup>
    <Warning Condition="!Exists('$(LauncherExe)')" Text="This build has no start helper (RunnerManagerLauncher.exe), so it registers its scheduled tasks at RunnerManager.exe." />
  </Target>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="RunnerManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\RunnerManager.ico" />
    <Resource Include="assets\RunnerManager.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>
</Project>
