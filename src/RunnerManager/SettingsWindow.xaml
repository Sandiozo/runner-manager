<Window x:Class="RunnerManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RunnerManager"
        Title="Settings" Icon="assets/RunnerManager.ico" Width="840" Height="580" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource Bg0Brush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <!-- A rounded group of rows; rows after the first get a divider line. -->
        <Style x:Key="Group" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>
        <Style TargetType="local:SettingRow">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingRow">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Glyph}" Style="{StaticResource Icon}" FontSize="16"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Title}"/>
                                <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Description" Value="">
                                <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Margin="14,18,10,14">
            <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,14"/>
            <TextBlock x:Name="NavVersionText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" FontSize="11" Margin="8,0,0,0"/>
            <ListBox x:Name="Nav" ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Nav_SelectionChanged">
                <ListBoxItem Tag="General">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Width="26"/>
                        <TextBlock Text="General"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Fleet">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" Width="26"/>
                        <TextBlock Text="Fleet"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Rdc">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AF;" Style="{StaticResource Icon}" Width="26"/>
                        <TextBlock Text="Remote Desktop Commander" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Updates">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Width="26"/>
                        <TextBlock Text="Updates"/>
                        <Border x:Name="UpdateDot" Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource AccentBrush}"
                                Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="8,18,24,8">
            <Grid>
                <!-- General -->
                <StackPanel x:Name="GeneralPage">
                    <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <local:SettingRow Glyph="&#xE790;" Title="Theme">
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystem" Content="System" Style="{StaticResource Segment}" GroupName="Theme" Checked="Theme_Checked"/>
                                        <RadioButton x:Name="ThemeDark" Content="Dark" Style="{StaticResource Segment}" GroupName="Theme" Checked="Theme_Checked"/>
                                        <RadioButton x:Name="ThemeLight" Content="Light" Style="{StaticResource Segment}" GroupName="Theme" Checked="Theme_Checked"/>
                                    </StackPanel>
                                </Border>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Glyph="&#xE72C;" Title="Refresh every" Description="Unchanged GitHub data does not use API quota.">
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Refresh5" Content="5 s" Style="{StaticResource Segment}" GroupName="Refresh" Checked="Refresh_Checked" Tag="5"/>
                                        <RadioButton x:Name="Refresh10" Content="10 s" Style="{StaticResource Segment}" GroupName="Refresh" Checked="Refresh_Checked" Tag="10"/>
                                        <RadioButton x:Name="Refresh30" Content="30 s" Style="{StaticResource Segment}" GroupName="Refresh" Checked="Refresh_Checked" Tag="30"/>
                                    </StackPanel>
                                </Border>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="STARTUP" Style="{StaticResource GroupLabel}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <local:SettingRow Glyph="&#xE7E8;" Title="Start with Windows" Description="Opens in the notification area when you sign in.">
                                <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" Click="StartupToggle_Click"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Glyph="&#xE8A7;" Title="Keep running when closed" Description="Monitoring continues in the notification area. Exit from its icon.">
                                <CheckBox x:Name="CloseToTrayToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="NOTIFICATIONS" Style="{StaticResource GroupLabel}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <local:SettingRow Glyph="&#xEA8F;" Title="Desktop notifications" Description="When a PC goes offline, a runner stops or auto-recovery takes action.">
                                <CheckBox x:Name="NotificationsToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Glyph="&#xE7BA;" Title="Failed workflow runs" Description="For repositories that use your runners.">
                                <CheckBox x:Name="FailedRunsToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Fleet -->
                <StackPanel x:Name="FleetPage" Visibility="Collapsed">
                    <TextBlock Text="Fleet" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <local:SettingRow x:Name="KeyRow" Glyph="&#xE8D7;" Title="Pairing code">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="GenerateKeyButton" Content="Start a new fleet" Style="{StaticResource PrimaryButton}" Click="GenerateKey_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="CopyKeyButton" Content="Copy" Click="CopyKey_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="KeyMenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More pairing code actions" Click="OpenMenu_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Enter pairing code…" Tag="&#xE70F;" Click="PasteKey_Click"/>
                                                <MenuItem x:Name="ReplaceKeyItem" Header="Replace pairing code…" Tag="&#xE72C;" Click="GenerateKey_Click"/>
                                                <MenuItem x:Name="RemoveKeyItem" Header="Remove pairing code…" Tag="&#xE74D;" Style="{StaticResource DangerMenuItem}" Click="RemoveKey_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </local:SettingRow>
                            <Grid x:Name="PasteKeyPanel" Visibility="Collapsed" Margin="46,0,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PasteKeyBox" Tag="rwk_…" FontFamily="{StaticResource MonoFont}"/>
                                <Button Grid.Column="1" Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SaveKey_Click"/>
                                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="CancelPasteKey_Click"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Glyph="&#xE83D;" Title="Auto-recovery on this PC"
                                              Description="Restarts runners that stop unexpectedly, up to 3 times an hour.">
                                <CheckBox x:Name="WatchdogToggle" Style="{StaticResource ToggleSwitch}" Click="WatchdogToggle_Click"/>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="FindPcsButton" DockPanel.Dock="Right" Content="Find PCs" Style="{StaticResource GhostButton}" Padding="8,2" FontSize="12" Click="FindPcs_Click"/>
                        <TextBlock Text="PCS IN THIS FLEET" Style="{StaticResource GroupLabel}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <StackPanel x:Name="PeersEmptyPanel">
                                <TextBlock Style="{StaticResource Hint}" Margin="14,12"
                                           Text="No other PCs yet. Use “Add a PC” in the sidebar of the dashboard to pair one."/>
                                <Border Style="{StaticResource Divider}"/>
                            </StackPanel>
                            <ItemsControl x:Name="PeersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <local:SettingRow Glyph="&#xE7F8;" Title="{Binding Name}" Description="{Binding Detail}">
                                                <Button Content="Forget" Style="{StaticResource GhostButton}" Padding="8,2" FontSize="12"
                                                        Tag="{Binding Name}" Click="ForgetPeer_Click"/>
                                            </local:SettingRow>
                                            <Border Style="{StaticResource Divider}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <local:SettingRow Glyph="&#xE774;" Title="Add a PC by address"
                                              Description="For PCs on another network.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="AddressBox" Tag="Tailscale name or IP" Width="180"/>
                                    <Button Content="Add" Margin="6,0,0,0" Click="AddAddress_Click"/>
                                </StackPanel>
                            </local:SettingRow>
                            <ItemsControl x:Name="AddressList" Margin="46,0,14,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource GhostButton}" Padding="8,2" FontSize="12"
                                                    Tag="{Binding}" Click="RemoveAddress_Click"/>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Group}">
                        <local:SettingRow Glyph="&#xE711;" Title="Leave the fleet" Description="Removes this PC and its fleet agent. Other PCs forget it.">
                            <Button x:Name="LeaveFleetButton" Content="Leave fleet…" Style="{StaticResource DangerButton}" Click="LeaveFleet_Click"/>
                        </local:SettingRow>
                    </Border>
                    <TextBlock x:Name="ThisPcAddressText" Style="{StaticResource Hint}" Margin="2,0,0,8"/>
                </StackPanel>

                <!-- Remote Desktop Commander -->
                <StackPanel x:Name="RdcPage" Visibility="Collapsed">
                    <TextBlock Text="Remote Desktop Commander" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Group}">
                        <local:SettingRow x:Name="RdcRow" Glyph="&#xE8AF;" Title="Not set up on this PC">
                            <Button x:Name="RdcSetupButton" Content="Set up" Click="RdcSetup_Click"/>
                        </local:SettingRow>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,0"
                               Text="Optional. Lets AI assistants operate this PC remotely. Runner Manager shows, monitors and restarts it only on PCs where it is set up. Setup needs Node.js and opens a console window for sign-in."/>
                </StackPanel>

                <!-- Updates -->
                <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
                    <TextBlock Text="Updates" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <local:SettingRow x:Name="VersionRow" Glyph="&#xE895;" Title="Runner Manager" Description="Checking for updates…">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="InstallUpdateButton" Content="Install" Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click"/>
                                </StackPanel>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Glyph="&#xE8A5;" Title="Release notes">
                                <Button Content="Open" Style="{StaticResource GhostButton}" Click="Releases_Click"/>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ADVANCED" Style="{StaticResource GroupLabel}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <local:SettingRow x:Name="RelayRow" Glyph="&#xE943;" Title="Release repository" Description="Where updates come from.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="RelayBox" Tag="owner/repository" Width="190"/>
                                    <Button x:Name="RelaySaveButton" Content="Save" Margin="6,0,0,0" Click="RelaySave_Click"/>
                                </StackPanel>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow x:Name="DataRow" Glyph="&#xE838;" Title="Data and logs">
                                <Button Content="Open folder" Style="{StaticResource GhostButton}" Click="OpenDataFolder_Click"/>
                            </local:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <local:SettingRow Glyph="&#xE74D;" Title="Uninstall Runner Manager" Description="Your runners and Remote Desktop Commander keep running.">
                                <Button Content="Uninstall…" Style="{StaticResource DangerButton}" Click="Uninstall_Click"/>
                            </local:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
