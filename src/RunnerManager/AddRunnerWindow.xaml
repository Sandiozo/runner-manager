<Window x:Class="RunnerManager.AddRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add runner" Icon="assets/RunnerManager.ico" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg1Brush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Add a self-hosted runner" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,20"
                       Text="Downloads the latest GitHub Actions runner, verifies its checksum, registers it with GitHub and installs it as a Windows service on this PC."/>

            <TextBlock Text="Repository or organization" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="RepositoryUrlBox" Tag="https://github.com/owner/repository" TextChanged="RepositoryUrlBox_TextChanged"/>
            <TextBlock x:Name="RepositoryHint" Style="{StaticResource FieldHint}" Text="Enter a repository URL or owner/repo. For an organization runner, enter the organization URL."/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Runner name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RunnerNameBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Custom labels" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LabelsBox" Tag="Optional, comma-separated"/>
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource FieldHint}" Text="The labels self-hosted, Windows and X64 are always added."/>

            <TextBlock Text="Install folder" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InstallPathBox"/>
                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>
            <TextBlock x:Name="InstallHint" Style="{StaticResource FieldHint}" Text="The folder must be empty or new."/>

            <CheckBox x:Name="CheckWorkflowsToggle" Style="{StaticResource ToggleSwitch}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Run hosted Windows jobs on this runner"/>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Changes runs-on: windows-latest (and windows-2019/2022/2025) in the repository workflows and commits the change."/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Click="Cancel_Click" MinWidth="88"/>
                <Button x:Name="CreateButton" Content="Create runner" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="Create_Click" Margin="8,0,0,0" MinWidth="120"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
