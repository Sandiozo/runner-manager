<Window x:Class="RunnerWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Icon="assets/RunnerManager.ico" Width="640" Height="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg0Brush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,6">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <!-- Appearance -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                        <DockPanel>
                            <TextBlock Text="Theme" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeSystem" Content="System" Style="{StaticResource Segment}" GroupName="Theme" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeDark" Content="Dark" Style="{StaticResource Segment}" GroupName="Theme" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeLight" Content="Light" Style="{StaticResource Segment}" GroupName="Theme" Checked="Theme_Checked"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Dashboard -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Dashboard" Style="{StaticResource SectionTitle}"/>

                        <DockPanel Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Refresh every"/>
                                <TextBlock Text="Unchanged GitHub data does not count against the API limit, so a short interval costs little." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Refresh5" Content="5 s" Style="{StaticResource Segment}" GroupName="Refresh" Checked="Refresh_Checked" Tag="5"/>
                                    <RadioButton x:Name="Refresh10" Content="10 s" Style="{StaticResource Segment}" GroupName="Refresh" Checked="Refresh_Checked" Tag="10"/>
                                    <RadioButton x:Name="Refresh30" Content="30 s" Style="{StaticResource Segment}" GroupName="Refresh" Checked="Refresh_Checked" Tag="30"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                        <CheckBox x:Name="NotificationsToggle" Style="{StaticResource ToggleSwitch}" Margin="0,8" Click="Toggle_Click">
                            <StackPanel>
                                <TextBlock Text="Desktop notifications"/>
                                <TextBlock Text="Shown when the window is not in focus and a PC goes offline, a runner stops, Remote Desktop Commander disconnects or auto-recovery takes action." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="FailedRunsToggle" Style="{StaticResource ToggleSwitch}" Margin="0,8" Click="Toggle_Click">
                            <StackPanel>
                                <TextBlock Text="Notify about failed workflow runs"/>
                                <TextBlock Text="For repositories that use your runners." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="CloseToTrayToggle" Style="{StaticResource ToggleSwitch}" Margin="0,8" Click="Toggle_Click">
                            <StackPanel>
                                <TextBlock Text="Keep running in the notification area when closed"/>
                                <TextBlock Text="Monitoring and notifications continue. To exit, use the icon in the notification area." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" Margin="0,8" Click="StartupToggle_Click">
                            <StackPanel>
                                <TextBlock Text="Start with Windows"/>
                                <TextBlock Text="Opens minimized in the notification area when you sign in." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Remote Desktop Commander -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Remote Desktop Commander" Style="{StaticResource SectionTitle}"/>
                        <DockPanel>
                            <Button x:Name="RdcSetupButton" DockPanel.Dock="Right" Content="Set up" VerticalAlignment="Center" Click="RdcSetup_Click"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock x:Name="RdcStatusText"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Optional. Lets AI assistants operate this PC remotely. Runner Manager shows, monitors and restarts it only on PCs where it is set up. Setup requires Node.js and opens a console window for sign-in."/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Fleet -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Fleet" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,14"
                                   Text="Your PCs connect directly over your local network, or over Tailscale from other networks. No traffic goes through GitHub. All traffic is encrypted with the pairing code."/>

                        <TextBlock Text="Pairing code" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="KeyStatusText" Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                        <WrapPanel>
                            <Button x:Name="GenerateKeyButton" Content="Start a new fleet" Click="GenerateKey_Click" Margin="0,0,8,6"/>
                            <Button x:Name="CopyKeyButton" Content="Copy pairing code" Click="CopyKey_Click" Margin="0,0,8,6"/>
                            <Button x:Name="PasteKeyButton" Content="Enter pairing code…" Click="PasteKey_Click" Margin="0,0,8,6"/>
                            <Button x:Name="RemoveKeyButton" Content="Remove pairing code…" Style="{StaticResource DangerButton}" Click="RemoveKey_Click" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <Grid x:Name="PasteKeyPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PasteKeyBox" Tag="rwk_…" FontFamily="{StaticResource MonoFont}"/>
                            <Button Grid.Column="1" Content="Save code" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="SaveKey_Click"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16"/>

                        <DockPanel>
                            <TextBlock Text="Your other PCs" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Button x:Name="FindPcsButton" Content="Find PCs" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,3" Click="FindPcs_Click"/>
                        </DockPanel>
                        <TextBlock x:Name="PeersEmptyText" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="No PCs found. PCs on the same network appear here after they join the fleet with the same pairing code."/>
                        <ItemsControl x:Name="PeersList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Bg0Brush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Forget" Style="{StaticResource GhostButton}" Padding="8,2" FontSize="12"
                                                    Tag="{Binding Name}" Click="ForgetPeer_Click"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource Caption}" FontSize="11">
                                                    <Run Text="{Binding Address, Mode=OneWay}"/><Run Text="  ·  last seen "/><Run Text="{Binding LastSeenText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Add a PC by address" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddressBox" Tag="e.g. build-laptop or 100.101.102.103"/>
                            <Button Grid.Column="1" Content="Add" Margin="8,0,0,0" Click="AddAddress_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="For a PC on a different network, install Tailscale on both PCs. Then enter the Tailscale name or 100.x address of the other PC."/>
                        <ItemsControl x:Name="AddressList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource GhostButton}" Padding="8,2" FontSize="12"
                                                Tag="{Binding}" Click="RemoveAddress_Click"/>
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ThisPcAddressText" Style="{StaticResource Hint}" Margin="0,8,0,0"/>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16"/>

                        <CheckBox x:Name="WatchdogToggle" Style="{StaticResource ToggleSwitch}" Click="WatchdogToggle_Click">
                            <StackPanel>
                                <TextBlock Text="Auto-recovery on this PC"/>
                                <TextBlock Text="The fleet agent restarts runners and Remote Desktop Commander when they stop unexpectedly, up to 3 times an hour. Anything you stop in Runner Manager stays stopped." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </CheckBox>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16"/>

                        <DockPanel>
                            <Button x:Name="LeaveFleetButton" DockPanel.Dock="Right" Content="Leave fleet…" Style="{StaticResource DangerButton}"
                                    VerticalAlignment="Center" Click="LeaveFleet_Click"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Leave the fleet" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Removes this PC from the fleet, together with its fleet agent and pairing code."/>
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16"/>

                        <TextBlock Text="Old GitHub relay data" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                                   Text="Earlier versions stored status in RW_STATUS_/RW_COMMAND_ Actions variables in the release repository. When all your PCs run this version, you can delete these variables."/>
                        <Button x:Name="DeleteRelayButton" Content="Delete old relay variables…" HorizontalAlignment="Left" Click="DeleteRelay_Click"/>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Release repository" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RelayBox" Tag="owner/repository"/>
                            <Button Grid.Column="1" x:Name="RelaySaveButton" Content="Save" Margin="8,0,0,0" Click="RelaySave_Click"/>
                        </Grid>
                        <TextBlock x:Name="VersionText"/>
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                        <TextBlock x:Name="RelayHint" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,-8,0,10"/>
                        <WrapPanel>
                            <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" Margin="0,0,8,6"/>
                            <Button x:Name="InstallUpdateButton" Content="Install" Style="{StaticResource PrimaryButton}" Click="InstallUpdate_Click" Margin="0,0,8,6" Visibility="Collapsed"/>
                            <Button x:Name="ReleasesButton" Content="Release notes" Style="{StaticResource GhostButton}" Click="Releases_Click" Margin="0,0,8,6"/>
                            <Button x:Name="UninstallButton" Content="Uninstall…" Style="{StaticResource DangerButton}" Click="Uninstall_Click" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Updates come from the GitHub Releases of the release repository and are verified with a checksum. They install to %LOCALAPPDATA%\Programs\RunnerManager with a Start menu shortcut. The fleet agent on this PC then runs from the installed copy."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <Button Content="Done" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="96" Click="Done_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
