<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RunnerManager\RunnerManager.csproj" />
  </ItemGroup>

  <!-- LauncherTests run RunnerManagerLauncher.exe with a stub in place of the app. Both are native and built by
       src\RunnerManagerLauncher\build.ps1 with the Visual C++ tools (it skips the work when they are up to date). Without
       the tools the build goes on and the launcher tests fail, saying why; with them (as on GitHub's windows-latest) the
       tests run for real. The two exes are copied to launcher\ in the test output. -->
  <PropertyGroup>
    <LauncherFolder>$(MSBuildThisFileDirectory)..\..\src\RunnerManagerLauncher\</LauncherFolder>
  </PropertyGroup>

  <Target Name="BuildLauncherForTests" BeforeTargets="BeforeBuild">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(LauncherFolder)build.ps1&quot; -TestStub -IfToolsPresent" />
  </Target>

  <Target Name="CopyLauncherForTests" AfterTargets="Build">
    <ItemGroup>
      <OldLauncherBinaries Include="$(OutDir)launcher\*.exe" />
      <!-- A wildcard here matches only what build.ps1 left in bin: nothing, when it found no C++ tools. -->
      <LauncherBinaries Include="$(LauncherFolder)bin\RunnerManagerLauncher.exe*;$(LauncherFolder)bin\LauncherTestStub.exe*" />
    </ItemGroup>
    <Delete Files="@(OldLauncherBinaries)" />
    <Copy SourceFiles="@(LauncherBinaries)" DestinationFolder="$(OutDir)launcher" />
  </Target>
</Project>
