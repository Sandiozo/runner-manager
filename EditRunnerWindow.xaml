<Window x:Class="RunnerWidget.EditRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit GitHub Runner" Icon="assets/RunnerManager.ico" Width="500" Height="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#0F1115" Foreground="#F4F6F8">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F6F8"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171B21"/><Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#343C48"/><Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F6F8"/><Setter Property="Background" Value="#242A33"/>
            <Setter Property="BorderBrush" Value="#343C48"/><Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Edit runner" FontSize="24" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="Runner name" Foreground="#AAB2BD" Margin="0,0,0,6"/>
            <TextBox x:Name="RunnerNameBox"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Custom labels" Foreground="#AAB2BD" Margin="0,0,0,6"/>
            <TextBox x:Name="LabelsBox"/>
            <TextBlock Text="Comma separated. Leave blank to keep the current labels." Foreground="#7F8996" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Margin="0,18,0,0" Foreground="#7F8996" TextWrapping="Wrap"
                   Text="Saving briefly re-registers this runner on its existing repository and machine. A busy runner cannot be edited."/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Content="Save" Click="Save_Click" Background="#285C45" BorderBrush="#39795C"/>
        </StackPanel>
    </Grid>
</Window>
