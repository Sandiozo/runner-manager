<Window x:Class="RunnerWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runner Manager" Width="1160" Height="820"
        MinWidth="860" MinHeight="620"
        Background="#0F1115" Foreground="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F6F8"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Background" Value="#242A33"/>
            <Setter Property="BorderBrush" Value="#343C48"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="170"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Runner Manager" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="GitHub Actions runners and Remote Desktop Commander" Foreground="#929BA8" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="GitHubStatusText" Text="GitHub: checking..." Foreground="#929BA8"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="GitHubConnectButton" Content="Connect GitHub" Click="GitHubConnect_Click"/>
                <Button Content="Add Runner" Click="AddRunner_Click" Background="#285C45" BorderBrush="#39795C"/>
                <Button Content="Refresh" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="GitHub Actions runners" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" x:Name="LastUpdatedText" Foreground="#68727F"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Runners}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#171B21" BorderBrush="#252C35" BorderThickness="1"
                                CornerRadius="8" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Start" Tag="{Binding Name}" Click="RunnerStart_Click"
                                                Visibility="{Binding ServiceButtonsVisibility}"/>
                                        <Button Content="Stop" Tag="{Binding Name}" Click="RunnerStop_Click"
                                                Visibility="{Binding ServiceButtonsVisibility}"/>
                                        <Button Content="Restart" Tag="{Binding Name}" Click="RunnerRestart_Click"
                                                Visibility="{Binding ServiceButtonsVisibility}"/>
                                        <Button Content="Repair Service" Tag="{Binding}" Click="RunnerRepair_Click"
                                                Visibility="{Binding RepairButtonVisibility}" Background="#6B5328" BorderBrush="#8A6B34"/>
                                        <Button Content="Workflows" Tag="{Binding}" Click="RunnerWorkflow_Click"/>
                                        <Button Content="Logs" Tag="{Binding InstallPath}" Click="RunnerLogs_Click"/>
                                        <Button Content="Remove" Tag="{Binding}" Click="RunnerRemove_Click"
                                                Background="#572D32" BorderBrush="#7B3D45"/>
                                    </WrapPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,10,0,0">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="   |   " Foreground="#5D6673"/>
                                    <TextBlock Text="{Binding ActivityText}" Foreground="#C3CAD3"/>
                                    <TextBlock Text="   |   " Foreground="#5D6673"/>
                                    <TextBlock Text="{Binding LastActivityText}" Foreground="#929BA8"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="{Binding GitHubText}" Foreground="#7FA5D6"
                                           Margin="20,7,0,0" FontSize="12"/>
                                <TextBlock Grid.Row="3" Text="{Binding CurrentWorkText}" Foreground="#D7DCE3"
                                           Margin="20,5,0,0" FontSize="12"/>
                                <TextBlock Grid.Row="4" Text="{Binding QueueText}" Foreground="#D5A85C"
                                           Margin="20,4,0,0" FontSize="12"/>
                                <TextBlock Grid.Row="5" Text="{Binding InstallPath}" Foreground="#68727F"
                                           Margin="20,5,0,0" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#171B21" BorderBrush="#252C35" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,14,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RemoteStatusDot" Width="10" Height="10" Fill="#D95555" Margin="0,0,10,0"/>
                        <TextBlock Text="Remote Desktop Commander" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,9,0,0">
                        <TextBlock x:Name="RemoteStatusText" Text="Checking..."/>
                        <TextBlock Text="   |   " Foreground="#5D6673"/>
                        <TextBlock x:Name="RemoteDetailsText" Foreground="#929BA8"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start" Click="RemoteStart_Click"/>
                    <Button Content="Stop" Click="RemoteStop_Click"/>
                    <Button Content="Restart" Click="RemoteRestart_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLog}"
                     Background="#11151A" BorderBrush="#252C35" Foreground="#B9C1CB"
                     Padding="8" FontFamily="Consolas" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
