<Window x:Class="RunnerWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runner Manager" Icon="assets/RunnerManager.ico" Width="1180" Height="900"
        MinWidth="900" MinHeight="680"
        Background="#0F1115" Foreground="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F6F8"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F6F8"/>
            <Setter Property="Background" Value="#242A33"/>
            <Setter Property="BorderBrush" Value="#343C48"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="StableActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Opacity="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#566374"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Runner Manager" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="GitHub runners and Remote Desktop Commander across your PCs" Foreground="#929BA8" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="GitHubStatusText" Text="GitHub: checking..." Foreground="#929BA8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="GitHubConnectButton" Content="Connect GitHub" Click="GitHubConnect_Click"/>
                <Button x:Name="GitHubReconnectButton" Click="GitHubReconnect_Click" ToolTip="Reconnect GitHub" Width="38" Padding="8" Visibility="Collapsed">
                    <Viewbox Width="15" Height="15">
                        <Path Stroke="#F4F6F8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 15,5 L 15,10 L 10,10 M 15,10 C 13.6,6.2 9.3,4.2 5.8,6 C 2.3,7.8 1.2,12.2 3.4,15.4 C 5.6,18.6 10.1,19.2 13,16.7 C 13.9,15.9 14.6,15 15,14"/>
                    </Viewbox>
                </Button>
                <Button x:Name="EnrollmentButton" Content="Add this PC" Click="InstallAgent_Click" ToolTip="Add this computer to Machines and enable remote runner/RDC status and controls"/>
                <Button Content="Add Runner" Click="AddRunner_Click" Background="#285C45" BorderBrush="#39795C"/>
                <TextBlock x:Name="LastUpdatedText" Text="Updated --" Foreground="#68727F" VerticalAlignment="Center" Margin="8,0,2,0" FontSize="11"/>
                <Button Content="Refresh" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Machines" FontSize="16" FontWeight="SemiBold"/>
        </Grid>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="380" Background="#171B21" BorderBrush="#252C35" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="GitHub Actions Runners" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Machines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#11151A" BorderBrush="#252C35" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding MachineName}" FontSize="13" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding RunnerSummary}" Foreground="#929BA8" FontSize="10"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="17,3,0,7">
                                                <TextBlock Text="{Binding AgentText}" Foreground="#929BA8" FontSize="10"/>
                                                <TextBlock Text="   |   " Foreground="#5D6673" FontSize="10"/>
                                                <TextBlock Text="{Binding RunnerSyncText}" Foreground="{Binding RunnerSyncBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Runners}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#171B21" CornerRadius="5" Padding="8" Margin="0,3,0,0" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="MachineRunnerCard_Click">
                                                            <Grid>
                                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0"/>
                                                                        <TextBlock Text="{Binding AgentName}" FontSize="12" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="   |   " Foreground="#5D6673"/>
                                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <Button Style="{StaticResource StableActionButton}" Tag="{Binding}" Click="MachineRunnerEdit_Click"
                                                                                IsEnabled="{Binding CanEdit}" Width="30" Height="28" Padding="7,6" ToolTip="Edit runner">
                                                                            <Viewbox Width="13" Height="13">
                                                                                <Path Stroke="#C3CAD3" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                                      Data="M 2,11 L 3,7.5 L 9.5,1 L 12,3.5 L 5.5,10 Z M 8.5,2 L 11,4.5"/>
                                                                            </Viewbox>
                                                                        </Button>
                                                                        <Button Content="{Binding PowerButtonText}" Tag="{Binding}" Click="MachineRunnerPower_Click"
                                                                                IsEnabled="{Binding CanControl}" Padding="8,4"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Visibility="{Binding DetailsVisibility}" Text="{Binding DisplayName}" Foreground="#C3CAD3" Margin="16,7,0,0" FontSize="11"/>
                                                                <TextBlock Grid.Row="2" Visibility="{Binding DetailsVisibility}" Text="{Binding RepositoryPath, StringFormat=Repository: {0}}" Foreground="#7FA5D6" Margin="16,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Grid.Row="3" Visibility="{Binding DetailsVisibility}" Margin="16,4,0,0">
                                                                    <TextBlock Text="{Binding ActivityText, StringFormat=Activity: {0}}" Foreground="#929BA8" FontSize="11"/>
                                                                    <TextBlock Text="{Binding ServiceText}" Foreground="#929BA8" FontSize="11" Margin="0,2,0,0"/>
                                                                    <TextBlock Text="{Binding ServiceName, StringFormat=Service: {0}}" Foreground="#68727F" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Machines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240" Background="#171B21" BorderBrush="#252C35" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Remote Desktop Commander" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding MachineName}" Foreground="#7FA5D6" FontSize="11" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Ellipse Width="9" Height="9" Fill="{Binding RdcStatusBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding RdcText}" Foreground="#C3CAD3" FontSize="12"/>
                                    </StackPanel>
                                    <Border Background="#11151A" BorderBrush="#252C35" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Connection &amp; activity" FontWeight="SemiBold" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <Ellipse Width="7" Height="7" Fill="{Binding RdcUsageBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RdcUsageText}" Foreground="#C3CAD3" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RdcProcessText}" Foreground="#C3CAD3" FontSize="11" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding RdcUptimeText}" Foreground="#929BA8" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding RdcSecurityStatusText}" Foreground="#929BA8" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding RdcPidText}" Foreground="#68727F" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource StableActionButton}" Content="{Binding RdcSetupButtonText}" Tag="{Binding}" Click="MachineRdcSetup_Click" IsEnabled="{Binding CanSetupRdc}" Visibility="{Binding RdcSetupVisibility}" Margin="0,12,0,0"/>
                                    <StackPanel Visibility="{Binding RdcControlsVisibility}">
                                        <Button Style="{StaticResource StableActionButton}" Content="{Binding RdcPowerButtonText}" Tag="{Binding}" Click="MachineRdcPower_Click" IsEnabled="{Binding CanControl}" Margin="0,12,0,0"/>
                                        <Button Style="{StaticResource StableActionButton}" Content="{Binding RdcRestartButtonText}" Tag="{Binding}" Click="MachineRdcRestart_Click" IsEnabled="{Binding CanControl}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastCommandResult}" Foreground="#68727F" Margin="0,10,0,0" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLog}" Background="#11151A" BorderBrush="#252C35" Foreground="#B9C1CB" Padding="8" FontFamily="Consolas" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
